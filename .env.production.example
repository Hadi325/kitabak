APP_NAME=myBooks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kitabak.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# Laravel Cloud injects the attached database variables.
DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Public Firebase Web configuration, injected before the Vite production build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=auth.kitabak.me
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Private server-only Firebase Admin configuration. In Laravel Cloud, use the
# complete compact service-account JSON value; do not Base64-encode it.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Private server-side AI configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=120

# Private server-side Twilio WhatsApp verification and book-alert configuration.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_OTP_EN=
TWILIO_TEMPLATE_OTP_AR=
TWILIO_TEMPLATE_BOOK_ALERT_EN=
TWILIO_TEMPLATE_BOOK_ALERT_AR=
TWILIO_TEMPLATE_BOOK_ALERT_FR=
